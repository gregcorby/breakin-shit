{
  "name": "donkey-gta",
  "version": "1.0.0",
  "description": "GTA-style game where you ride a donkey and kick people for points",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "download-prebuilt": "node scripts/download-prebuilt.js",
    "download-assets": "node scripts/download-assets.js",
    "export-godot-android": "cd godot && ./export_game.sh android",
    "export-godot-ios": "cd godot && ./export_game.sh ios"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.0",
    "@borndotcom/react-native-godot": "^0.1.0",
    "expo-file-system": "^16.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/runtime": "^7.23.0",
    "@react-native/babel-preset": "0.73.0",
    "@react-native/eslint-config": "0.73.0",
    "@react-native/metro-config": "0.73.0",
    "@react-native/typescript-config": "0.73.0",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "^3.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
